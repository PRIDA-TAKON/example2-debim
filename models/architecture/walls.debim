elements:
  # ==========================================
  # ผนังชั้นที่ 1 (L1)
  # ==========================================
  # ผนังรอบห้องรับแขก (Living Room)
  - class: IfcWall
    tag: WALL-L1-LIVING-SOUTH
    name: ผนังหน้าห้องรับแขก
    material: AAC_BLOCK
    thickness: 0.10
    height: 2.90
    placement: { from_grid: ["5", "B"], to_grid: ["7", "B"], storey: L1 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L1-LIVING-EAST
    name: ผนังข้างห้องรับแขกฝั่งตะวันออก
    material: AAC_BLOCK
    thickness: 0.10
    height: 2.90
    placement: { from_grid: ["7", "B"], to_grid: ["7", "D"], storey: L1 }
    layer: architecture/walls

  # ผนังห้องรับประทานอาหาร (Dining Room)
  - class: IfcWall
    tag: WALL-L1-DINING-EAST
    name: ผนังห้องทานอาหารฝั่งตะวันออก
    material: AAC_BLOCK
    thickness: 0.10
    height: 2.90
    placement: { from_grid: ["7", "D"], to_grid: ["7", "F"], storey: L1 }
    layer: architecture/walls

  # ผนังห้องครัว (Kitchen)
  - class: IfcWall
    tag: WALL-L1-KITCHEN-EAST
    name: ผนังครัวฝั่งตะวันออก
    material: AAC_BLOCK
    thickness: 0.10
    height: 2.70
    placement: { from_grid: ["7", "F"], to_grid: ["7", "G"], storey: L1 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L1-KITCHEN-NORTH
    name: ผนังครัวฝั่งหลังบ้าน
    material: AAC_BLOCK
    thickness: 0.10
    height: 2.70
    placement: { from_grid: ["5", "G"], to_grid: ["7", "G"], storey: L1 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L1-KITCHEN-WEST
    name: ผนังกั้นครัวกับซักล้าง
    material: AAC_BLOCK
    thickness: 0.10
    height: 2.70
    placement: { from_grid: ["5", "F"], to_grid: ["5", "G"], storey: L1 }
    layer: architecture/walls

  # ผนังห้องน้ำแขก (Powder Room - ใช้อิฐมอญกันชื้น)
  - class: IfcWall
    tag: WALL-L1-WC-WEST
    name: ผนังห้องน้ำแขกฝั่งซ้าย
    material: BRICK_MON
    thickness: 0.10
    height: 2.60
    placement: { from_grid: ["3", "D"], to_grid: ["3", "E"], storey: L1 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L1-WC-SOUTH
    name: ผนังห้องน้ำแขกฝั่งใต้
    material: BRICK_MON
    thickness: 0.10
    height: 2.60
    placement: { from_grid: ["3", "D"], to_grid: ["4", "D"], storey: L1 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L1-WC-NORTH
    name: ผนังห้องน้ำแขกฝั่งเหนือ
    material: BRICK_MON
    thickness: 0.10
    height: 2.60
    placement: { from_grid: ["3", "E"], to_grid: ["4", "E"], storey: L1 }
    layer: architecture/walls

  # ==========================================
  # ผนังชั้นที่ 2 (L2)
  # ==========================================
  # ผนังรอบ Master Bedroom
  - class: IfcWall
    tag: WALL-L2-MBR-SOUTH
    name: ผนังหน้าห้องนอนใหญ่
    material: AAC_BLOCK
    thickness: 0.10
    height: 3.00
    placement: { from_grid: ["5", "B"], to_grid: ["7", "B"], storey: L2 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L2-MBR-EAST
    name: ผนังข้างห้องนอนใหญ่
    material: AAC_BLOCK
    thickness: 0.10
    height: 3.00
    placement: { from_grid: ["7", "B"], to_grid: ["7", "D"], storey: L2 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L2-MBR-BATH-EAST
    name: ผนังข้างห้องน้ำ Master
    material: BRICK_MON
    thickness: 0.10
    height: 2.60
    placement: { from_grid: ["7", "D"], to_grid: ["7", "F"], storey: L2 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L2-MBR-BATH-NORTH
    name: ผนังหลังห้องน้ำ Master
    material: BRICK_MON
    thickness: 0.10
    height: 2.60
    placement: { from_grid: ["5", "F"], to_grid: ["7", "F"], storey: L2 }
    layer: architecture/walls

  # ผนัง Bedroom 2
  - class: IfcWall
    tag: WALL-L2-BED2-SOUTH
    name: ผนังหน้า Bedroom 2
    material: AAC_BLOCK
    thickness: 0.10
    height: 3.00
    placement: { from_grid: ["2", "B"], to_grid: ["4", "B"], storey: L2 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L2-BED2-WEST
    name: ผนังข้าง Bedroom 2
    material: AAC_BLOCK
    thickness: 0.10
    height: 3.00
    placement: { from_grid: ["2", "B"], to_grid: ["2", "D"], storey: L2 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L2-BED2-BATH-WEST
    name: ผนังห้องน้ำ 2
    material: BRICK_MON
    thickness: 0.10
    height: 2.60
    placement: { from_grid: ["3", "D"], to_grid: ["3", "E"], storey: L2 }
    layer: architecture/walls

  # ผนัง Bedroom 3
  - class: IfcWall
    tag: WALL-L2-BED3-WEST
    name: ผนังข้าง Bedroom 3
    material: AAC_BLOCK
    thickness: 0.10
    height: 3.00
    placement: { from_grid: ["2", "E"], to_grid: ["2", "F"], storey: L2 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L2-BED3-NORTH
    name: ผนังหลัง Bedroom 3
    material: AAC_BLOCK
    thickness: 0.10
    height: 3.00
    placement: { from_grid: ["2", "F"], to_grid: ["4", "F"], storey: L2 }
    layer: architecture/walls
  - class: IfcWall
    tag: WALL-L2-BED3-BATH-WEST
    name: ผนังห้องน้ำ 3
    material: BRICK_MON
    thickness: 0.10
    height: 2.60
    placement: { from_grid: ["3", "E"], to_grid: ["3", "F"], storey: L2 }
    layer: architecture/walls
