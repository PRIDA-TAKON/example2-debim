elements:
  # ==========================================
  # สเปซพื้นที่ใช้สอยชั้นที่ 1 (L1)
  # ==========================================
  - class: IfcSpace
    tag: SPACE-PARK
    name: ที่จอดรถ (2 คัน)
    height: 2.80
    floor_thickness: 0.12
    drop_elevation: -0.15
    placement:
      storey: L1
      boundary: [["1", "A"], ["4", "A"], ["4", "D"], ["1", "D"]]
    layer: architecture/spaces
  - class: IfcSpace
    tag: SPACE-PORCH
    name: เฉลียงทางเข้าหลัก
    height: 2.85
    floor_thickness: 0.10
    drop_elevation: -0.05
    placement:
      storey: L1
      boundary: [["4", "B"], ["5", "B"], ["5", "C"], ["4", "C"]]
    layer: architecture/spaces
  - class: IfcSpace
    tag: SPACE-FOYER-L1
    name: โถงต้อนรับและทางเดินชั้น 1
    height: 2.90
    floor_thickness: 0.12
    placement:
      storey: L1
      boundary: [["4", "C"], ["5", "C"], ["5", "E"], ["4", "E"]]
    layer: architecture/spaces
  - class: IfcSpace
    tag: SPACE-LIVING
    name: ห้องรับแขกและนั่งเล่น
    height: 2.90
    floor_thickness: 0.12
    placement:
      storey: L1
      boundary: [["5", "B"], ["7", "B"], ["7", "D"], ["5", "D"]]
    layer: architecture/spaces
  - class: IfcSpace
    tag: SPACE-DINING
    name: ห้องรับประทานอาหาร
    height: 2.90
    floor_thickness: 0.12
    placement:
      storey: L1
      boundary: [["5", "D"], ["7", "D"], ["7", "F"], ["5", "F"]]
    layer: architecture/spaces
  - class: IfcSpace
    tag: SPACE-KITCHEN
    name: ห้องครัว
    height: 2.70
    floor_thickness: 0.12
    placement:
      storey: L1
      boundary: [["5", "F"], ["7", "F"], ["7", "G"], ["5", "G"]]
    layer: architecture/spaces
  - class: IfcSpace
    tag: SPACE-WC-GUEST
    name: ห้องน้ำแขก (Powder Room)
    height: 2.60
    floor_thickness: 0.10
    drop_elevation: -0.05
    placement:
      storey: L1
      boundary: [["3", "D"], ["4", "D"], ["4", "E"], ["3", "E"]]
    layer: architecture/spaces
  - class: IfcSpace
    tag: SPACE-STAIR-L1
    name: โถงบันได
    height: 3.20
    floor_thickness: 0.12
    placement:
      storey: L1
      boundary: [["4", "E"], ["5", "E"], ["5", "F"], ["4", "F"]]
    layer: architecture/spaces

  # ==========================================
  # สเปซพื้นที่ใช้สอยชั้นที่ 2 (L2)
