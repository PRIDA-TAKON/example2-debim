elements:
  # ==========================================
  # สุขภัณฑ์ชั้นที่ 1 (L1)
  # ==========================================
  - class: IfcSanitaryTerminal
    tag: WC-GUEST
    name: โถสุขภัณฑ์ห้องน้ำแขก (Dual Flush)
    predefined_type: WATERCLOSET
    placement:
      grid: ["3", "D"]
      storey: L1
      offset_x: 0.50
      offset_y: 0.50
      offset_z: 0.00
    layer: mep/fixtures

  - class: IfcSanitaryTerminal
    tag: BASIN-GUEST
    name: อ่างล้างหน้าห้องน้ำแขก
    predefined_type: WASHHANDBASIN
    placement:
      grid: ["4", "D"]
      storey: L1
      offset_x: -0.50
      offset_y: 0.50
      offset_z: 0.85
    layer: mep/fixtures

  - class: IfcSanitaryTerminal
    tag: SINK-KITCHEN
    name: อ่างล้างจานสแตนเลส 2 หลุมห้องครัว
    predefined_type: SINK
    placement:
      grid: ["6", "G"]
      storey: L1
      offset_x: 0.00
      offset_y: -0.60
      offset_z: 0.85
    layer: mep/fixtures

  # ==========================================
  # สุขภัณฑ์ชั้นที่ 2 (L2)
