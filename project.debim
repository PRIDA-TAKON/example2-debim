# yaml-language-server: $schema=./debim.schema.json
schema: IFC4-Minimal

project:
  id: PRJ-MODERN-TROPICAL-2STOREY
  name: บ้านเดี่ยวสองชั้น Modern Tropical (3 ห้องนอน 4 ห้องน้ำ)
  units:
    length: METER
    area: SQUARE_METER
    volume: CUBIC_METER

spatial_structure:
  storeys:
    - id: Foundation
      name: ระดับฐานราก (Foundation Level)
      elevation: -1.20
      height: 1.20
    - id: L1
      name: ชั้น 1 (Ground Floor)
      elevation: 0.30
      height: 3.20
    - id: L2
      name: ชั้น 2 (Second Floor)
      elevation: 3.50
      height: 3.00
    - id: Roof
      name: ชั้นหลังคา (Roof Level)
      elevation: 6.50
      height: 2.00

grids:
  axes_x:
    "1": 2.50
    "2": 3.50
    "3": 6.00
    "4": 8.00
    "5": 10.50
    "6": 13.00
    "7": 15.50
  axes_y:
    "A": 3.50
    "B": 4.50
    "C": 7.50
    "D": 9.50
    "E": 12.00
    "F": 14.50
    "G": 18.00

materials:
  - id: CONC_240
    name: คอนกรีตผสมเสร็จ 240 ksc (Cylinder)
    category: concrete
    unit_cost_ref: MAT-C240
  - id: REBAR_SD40
    name: เหล็กข้ออ้อย SD40 (DB12, DB16, DB20)
    category: rebar
    unit_cost_ref: MAT-SD40
  - id: REBAR_SR24
    name: เหล็กเส้นกลม SR24 (RB6, RB9)
    category: rebar
    unit_cost_ref: MAT-SR24
  - id: LEAN_CONC
    name: คอนกรีตหยาบรองฐานราก 5 ซม.
    category: concrete
    unit_cost_ref: MAT-LEAN
  - id: AAC_BLOCK
    name: อิฐมวลเบา G4 หนา 7.5 ซม.
    category: masonry
    unit_cost_ref: MAT-AAC
  - id: BRICK_MON
    name: อิฐมอญก่อครึ่งแผ่น หนา 7 ซม. (ห้องน้ำ)
    category: masonry
    unit_cost_ref: MAT-BRICK
  - id: PLASTER_PAINT_EXT
    name: ปูนฉาบกันซึม 15 มม. + สีอะคริลิกภายนอก
    category: finish
    unit_cost_ref: MAT-P-EXT
  - id: PLASTER_PAINT_INT
    name: ปูนฉาบเรียบ 15 มม. + สีน้ำอะคริลิกภายใน
    category: finish
    unit_cost_ref: MAT-P-INT
  - id: TILE_WALL_PORCELAIN
    name: กระเบื้องพอร์ซเลนบุผนังห้องน้ำ 30x60 ซม.
    category: finish
    unit_cost_ref: MAT-TILE-WALL
  - id: TILE_FLOOR_60X60
    name: กระเบื้องแกรนิตโต้ปูพื้น 60x60 ซม.
    category: finish
    unit_cost_ref: MAT-TILE-FLOOR
  - id: SPC_FLOOR_VINYL
    name: พื้นไม้ SPC ลายไม้หนา 5.5 มม. (ชั้น 2)
    category: finish
    unit_cost_ref: MAT-SPC-FLOOR
  - id: ROOF_METALSHEET_PU
    name: แผ่นหลังคาเหล็กรีดลอน Seamless + ฉนวน PU Foam 25 มม.
    category: roofing
    unit_cost_ref: MAT-METALROOF
  - id: GLASS_ALU_DOOR
    name: ประตูกรอบอะลูมิเนียมอบดำ กระจกเขียวตัดแสง 6 มม.
    category: door
    unit_cost_ref: MAT-ALU-DOOR
  - id: WOOD_DOOR_HDF
    name: ประตูไม้สังเคราะห์ HDF ทำสีพร้อมวงกบ WPC
    category: door
    unit_cost_ref: MAT-HDF-DOOR
  - id: PVC_DOOR
    name: ประตู UPVC กันน้ำห้องน้ำ 0.70x2.00 ม.
    category: door
    unit_cost_ref: MAT-UPVC-DOOR
  - id: GLASS_ALU_WINDOW
    name: หน้าต่างกรอบอะลูมิเนียมอบดำ กระจกเขียวตัดแสง 6 มม.
    category: window
    unit_cost_ref: MAT-ALU-WIN

includes:
  - models/**/*.yaml
